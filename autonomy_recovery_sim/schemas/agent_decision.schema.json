                  "PERCEPTION_DEGRADED",
                  "RECOVERY_TIME_EXCEEDED",
                  "UNRECOVERABLE_BLOCKAGE",
                  "DESTINATION_UNREACHABLE",
                  "SAFETY_CONCERN"
